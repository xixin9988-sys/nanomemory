# NanoMemory example environment file. Copy to .env and fill in your own values.
# NEVER commit a .env file containing real credentials.

# ---------------------------------------------------------------- storage
NANOMEMORY_STORAGE_ROOT=storage
NANOMEMORY_ENVIRONMENT=development

# ---------------------------------------------------------------- provider
# mock (default, no API key required) or openai_compatible
NANOMEMORY_PROVIDER=mock
NANOMEMORY_API_KEY=
NANOMEMORY_BASE_URL=
NANOMEMORY_MODEL=mock-echo
NANOMEMORY_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------- agent loop
NANOMEMORY_MAX_ITERATIONS=5
NANOMEMORY_AGENT_TIMEOUT_SECONDS=120
NANOMEMORY_AGENT_MAX_TOTAL_TOKENS=20000
NANOMEMORY_AGENT_MAX_TOOL_CALLS=8
NANOMEMORY_AGENT_MAX_WALL_TIME_SECONDS=180
# Cost budget is only enforced when a price table is configured.
# NANOMEMORY_AGENT_MAX_COST=

# ---------------------------------------------------------------- token budgets
NANOMEMORY_CONTEXT_TOKEN_BUDGET=8000
NANOMEMORY_REQUEST_TOKEN_BUDGET=8000

# ---------------------------------------------------------------- pricing (optional)
# JSON: {"<model>": {"input_per_1k": 0.0, "output_per_1k": 0.0, "currency": "USD"}}
NANOMEMORY_PRICE_TABLE_JSON=

# ---------------------------------------------------------------- security
# Required for destructive admin endpoints (backup/restore/permanent delete/export).
# Leave empty to disable those endpoints entirely.
NANOMEMORY_ADMIN_TOKEN=
# reject (default) or redact
NANOMEMORY_SECRET_SCAN_MODE=reject
# Optional extra allowlist regex for the generic high-entropy rule only.
NANOMEMORY_SECRET_ALLOWLIST_REGEX=

# ---------------------------------------------------------------- sessions / http
# single (default) or multi
NANOMEMORY_SESSION_MODE=single
NANOMEMORY_WORKER_COUNT=1
# Comma separated allowlist; empty means CORS stays closed.
NANOMEMORY_CORS_ALLOW_ORIGINS=

# ---------------------------------------------------------------- limits
NANOMEMORY_RATE_LIMIT_ENABLED=true
NANOMEMORY_RATE_LIMIT_PER_MINUTE=60
NANOMEMORY_RATE_LIMIT_SESSION_CREATE_PER_MINUTE=10
NANOMEMORY_RATE_LIMIT_AGENT_PER_MINUTE=20
NANOMEMORY_REQUEST_MAX_BYTES=1000000

# ---------------------------------------------------------------- retention
NANOMEMORY_WORKING_SNAPSHOT_RETENTION=10
NANOMEMORY_ORPHAN_TMP_MAX_AGE_SECONDS=86400
NANOMEMORY_BACKUP_RETENTION_COUNT=10
NANOMEMORY_BACKUP_RETENTION_DAILY=7
NANOMEMORY_LONG_TERM_CAPACITY_LIMIT=5000

# ---------------------------------------------------------------- metrics
NANOMEMORY_METRICS_ENABLED=true
NANOMEMORY_METRICS_MAX_BYTES=10485760
NANOMEMORY_METRICS_BACKUP_COUNT=5

# ---------------------------------------------------------------- logging
NANOMEMORY_LOG_LEVEL=INFO
NANOMEMORY_LOG_FORMAT=console
